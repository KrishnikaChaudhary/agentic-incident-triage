# Copy to .env (git-ignored) and export, or pass to docker compose with --env-file.
# Never commit real keys or tokens. Everything is optional except where noted.

# --- server ---
# Required whenever TRIAGE_HOST is not loopback (the server refuses to start without it):
# TRIAGE_SERVER_TOKEN=generate-with-openssl-rand-hex-24
TRIAGE_HOST=127.0.0.1
TRIAGE_PORT=8080
TRIAGE_DB=triage.db
TRIAGE_MAX_CONCURRENT=4
TRIAGE_MAX_BODY_BYTES=65536
TRIAGE_LOG_LEVEL=INFO

# --- per-run guardrails ---
TRIAGE_MAX_COST_USD=0.50
TRIAGE_MAX_LLM_CALLS=40
TRIAGE_MAX_TOTAL_TOKENS=60000
TRIAGE_RUN_TIMEOUT_S=120
TRIAGE_DEFAULT_CONFIG=optimized

# --- model: "mock" runs fully offline; "env" uses the real model configured below ---
TRIAGE_LLM=mock
# TRIAGE_PROVIDER=anthropic            # or: openai (any OpenAI-compatible endpoint)
# ANTHROPIC_API_KEY=                   # or OPENAI_API_KEY / TRIAGE_API_KEY
# TRIAGE_MODEL_SMALL=                  # cheap tier model id
# TRIAGE_MODEL_LARGE=                  # strong tier model id
# TRIAGE_PRICE_SMALL=0.25,1.25         # USD per 1M tokens: input,output (use your provider's real prices)
# TRIAGE_PRICE_LARGE=3,15
# TRIAGE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
